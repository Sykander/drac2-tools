# regex — small regexp engine for Drac2 (no stdlib re). Syntax, public API, Avrae limits:
# docs/gvars/regex.md
#
# compile() -> dict (pattern string, groups count, fullmatch/match/search, capture helpers,
# program). compile_program() -> opcode list for match_from, full_match, search_from, etc.
#
# Supported: literals, ., \\d..\\S, ? * +, {n}/{n,}/{n,m}, () captures, (?:), [] classes, |.
# In []: literals, a-z/A-Z/0-9 ranges, only \\d \\w \\s. \\| for literal |.
# Not: ^ $ anchors, backrefs, (?P<name>), \\D\\W\\S inside classes (use e.g. [^0-9]).
#
# Quantifiers backtrack; alternation tries each arm in source order.

# Last ``_rx_err`` payload for diagnostics (e.g. tests): ``(message, index_or_None)`` before ``err()`` fires.
_RX_DIAG = {"last": None}


def _rx_err(msg: str, idx: int = None):
    """
    Raise a parse error; ``idx`` is a 0-based index into the pattern when known.

    **No index** (call with one argument only):

    - ``pattern is None`` — not a string, so there is no code-unit offset in a pattern.
    - ``internal: expected plain atom`` — matcher invariant / bug; not tied to a user pattern
      character (the bad ``node`` comes from an already-compiled program).
    - ``trailing junk`` — post-parse guard: ``compile_program`` requires the whole ``pat`` to be
      consumed. If ``i != len(pat)`` after ``_parse_alt``, this reports the first unconsumed index.
      For the supported grammar today, other branches already reject leftovers, so this path is
      defensive (kept with an index for consistency if a future change makes it reachable).
    - ``range endpoints must be single chars`` inside ``_range_expand`` — ``compile_program`` only
      passes single-character endpoints from ``_parse_class``; the index is still passed for
      consistency if that invariant ever breaks.
    - ``bad escape in class`` inside ``_expand_set_escape`` — current ``_parse_escape`` output is
      always ``lit`` or ``cls``; this branch is defensive for non-``lit`` / non-``cls`` escape dicts.
    """
    _RX_DIAG["last"] = (msg, idx)
    if idx == None:
        err(f"regex: {msg}")
    else:
        err(f"regex: {msg} (at index {idx})")


def _digit_val(ch: str) -> int:
    digits = "0123456789"
    k = 0
    while k < 10:
        if ch == digits[k]:
            return k
        k = k + 1
    return 0


def _parse_int(pat: str, i: int):
    n_pat = len(pat)
    if i >= n_pat or pat[i] < "0" or pat[i] > "9":
        return None, i
    n = 0
    while i < n_pat and pat[i] >= "0" and pat[i] <= "9":
        n = n * 10 + _digit_val(pat[i])
        i = i + 1
    return n, i


def _parse_brace(pat: str, i: int):
    # i points at '{'
    j = i + 1
    if j >= len(pat):
        _rx_err("unclosed {", i)
    min_n, j = _parse_int(pat, j)
    if min_n == None:
        _rx_err("{ needs a number", j)
    if j < len(pat) and pat[j] == "}":
        return min_n, min_n, j + 1
    if j >= len(pat) or pat[j] != ",":
        _rx_err("{ expected , or }", j)
    j = j + 1
    max_n = None
    if j < len(pat) and pat[j] == "}":
        max_n = None
        j = j + 1
    else:
        max_n, j = _parse_int(pat, j)
        if max_n == None:
            _rx_err("{ expected number after ,", j)
        if j >= len(pat) or pat[j] != "}":
            _rx_err("unclosed {", i)
        j = j + 1
    return min_n, max_n, j


def _parse_escape(pat: str, i: int):
    # i points at backslash
    if i + 1 >= len(pat):
        _rx_err("dangling \\", i)
    n = pat[i + 1]
    if n == "d":
        return {"k": "cls", "c": "d"}, i + 2
    if n == "D":
        return {"k": "cls", "c": "D"}, i + 2
    if n == "w":
        return {"k": "cls", "c": "w"}, i + 2
    if n == "W":
        return {"k": "cls", "c": "W"}, i + 2
    if n == "s":
        return {"k": "cls", "c": "s"}, i + 2
    if n == "S":
        return {"k": "cls", "c": "S"}, i + 2
    if n == "|":
        return {"k": "lit", "v": "|"}, i + 2
    return {"k": "lit", "v": n}, i + 2


def _is_digit(ch: str) -> bool:
    return ch >= "0" and ch <= "9"


def _is_space(ch: str) -> bool:
    return ch == " " or ch == "\t" or ch == "\n" or ch == "\r"


def _is_word(ch: str) -> bool:
    return _is_digit(ch) or (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"


def _cls_ok(c: str, kind: str) -> bool:
    if kind == "d":
        return _is_digit(c)
    if kind == "D":
        return not _is_digit(c)
    if kind == "w":
        return _is_word(c)
    if kind == "W":
        return not _is_word(c)
    if kind == "s":
        return _is_space(c)
    if kind == "S":
        return not _is_space(c)
    return False


def _expand_set_escape(e, at_idx: int):
    if e["k"] == "lit":
        return e["v"]
    if e["k"] != "cls":
        _rx_err("bad escape in class", at_idx)
    c = e["c"]
    if c == "d":
        return "0123456789"
    if c == "w":
        return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    if c == "s":
        return " \t\n\r"
    _rx_err("only \\d \\w \\s allowed inside []", at_idx)


def _range_expand(lo: str, hi: str, at_idx: int) -> str:
    if len(lo) != 1 or len(hi) != 1:
        _rx_err("range endpoints must be single chars", at_idx)
    lows = "abcdefghijklmnopqrstuvwxyz"
    ups = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    digs = "0123456789"

    def _span(pool: str, a: str, b: str) -> str:
        si = None
        ei = None
        k = 0
        while k < len(pool):
            if pool[k] == a:
                si = k
            if pool[k] == b:
                ei = k
            k = k + 1
        if si == None or ei == None or si > ei:
            _rx_err("bad range", at_idx)
        out = ""
        while si <= ei:
            out += pool[si]
            si = si + 1
        return out

    if lo >= "a" and hi <= "z" and lo <= hi:
        return _span(lows, lo, hi)
    if lo >= "A" and hi <= "Z" and lo <= hi:
        return _span(ups, lo, hi)
    if lo >= "0" and hi <= "9" and lo <= hi:
        return _span(digs, lo, hi)
    _rx_err("range must stay in a-z, A-Z, or 0-9", at_idx)


def _parse_class(pat: str, i: int):
    # i points at '['
    j = i + 1
    if j >= len(pat):
        _rx_err("unclosed [", i)
    neg = False
    if pat[j] == "^":
        neg = True
        j = j + 1
    acc_parts = []

    def _acc_add(s: str):
        if len(s) > 0:
            acc_parts.append(s)
    pending = None
    while j < len(pat) and pat[j] != "]":
        c = pat[j]
        if c == "\\":
            e, j2 = _parse_escape(pat, j)
            ex = _expand_set_escape(e, j)
            if pending != None:
                _acc_add(pending)
                pending = None
            _acc_add(ex)
            j = j2
            continue
        if c == "-" and pending != None and j + 1 < len(pat) and pat[j + 1] != "]":
            hi = pat[j + 1]
            if hi == "\\":
                _rx_err("range end must be literal", j + 1)
            _acc_add(_range_expand(pending, hi, j))
            pending = None
            j = j + 2
            continue
        if c == "-":
            if pending != None:
                _acc_add(pending)
                pending = None
            pending = "-"
            j = j + 1
            continue
        if pending != None:
            _acc_add(pending)
        pending = c
        j = j + 1
    if j >= len(pat):
        _rx_err("unclosed [", i)
    if pending != None:
        _acc_add(pending)
    acc = "".join(acc_parts)
    if len(acc) == 0 and not neg:
        _rx_err("empty []", j)
    set_map = {}
    k = 0
    while k < len(acc):
        set_map[acc[k]] = True
        k = k + 1
    return {"k": "set", "n": neg, "s": acc, "m": set_map}, j + 1


def _char_in_set(ch: str, s: str) -> bool:
    k = 0
    while k < len(s):
        if ch == s[k]:
            return True
        k = k + 1
    return False


def _wrap_rep(atom, lo: int, hi):
    return {"k": "rep", "a": atom, "lo": lo, "hi": hi}


def _parse_quant(pat: str, i: int, atom):
    if i >= len(pat):
        return atom, i
    q = pat[i]
    if q == "?":
        return _wrap_rep(atom, 0, 1), i + 1
    if q == "*":
        return _wrap_rep(atom, 0, None), i + 1
    if q == "+":
        return _wrap_rep(atom, 1, None), i + 1
    if q == "{":
        lo, hi, j = _parse_brace(pat, i)
        return _wrap_rep(atom, lo, hi), j
    return atom, i


def _parse_seq_concat(pat: str, i: int, in_group: bool, cap_counter: list, group_start: int = None):
    """Parse one concatenation arm; stops before `|`, `)`, or end (if not in a group)."""
    nodes = []
    while i < len(pat):
        if in_group and pat[i] == ")":
            return nodes, i
        if pat[i] == "|":
            return nodes, i
        if not in_group and pat[i] == ")":
            _rx_err("unexpected )", i)
        atom = None
        c = pat[i]
        if c == "(":
            if i + 2 < len(pat) and pat[i + 1] == "?":
                if i + 3 < len(pat) and pat[i + 2] == ":":
                    inner, j = _parse_alt(pat, i + 3, True, cap_counter, i)
                    if j >= len(pat) or pat[j] != ")":
                        _rx_err("unclosed (", i)
                    atom = {"k": "grp", "g": inner}
                    i = j + 1
                else:
                    _rx_err("unsupported (?...) only (?:...) is allowed", i)
            else:
                inner, j = _parse_alt(pat, i + 1, True, cap_counter, i)
                if j >= len(pat) or pat[j] != ")":
                    _rx_err("unclosed (", i)
                cap_counter[0] = cap_counter[0] + 1
                atom = {"k": "grp", "g": inner, "cap": cap_counter[0]}
                i = j + 1
        elif c == "[":
            atom, i = _parse_class(pat, i)
        elif c == ".":
            atom = {"k": "dot"}
            i = i + 1
        elif c == "\\":
            atom, i = _parse_escape(pat, i)
        elif c == "{" or c == "}" or c == "*" or c == "+" or c == "?" or c == "]":
            _rx_err(f"unexpected {c}", i)
        else:
            atom = {"k": "lit", "v": c}
            i = i + 1
        atom, i = _parse_quant(pat, i, atom)
        nodes.append(atom)
    if in_group:
        _rx_err("unclosed (", group_start if group_start != None else 0)
    return nodes, i


def _parse_alt(pat: str, i: int, in_group: bool, cap_counter: list, group_start: int = None):
    """Parse ``|`` at this depth (or top level). Returns ``(nodes, end_index)``."""
    arms = []
    cur = i
    while True:
        arm, j = _parse_seq_concat(pat, cur, in_group, cap_counter, group_start)
        arms.append(arm)
        if j < len(pat) and pat[j] == "|":
            cur = j + 1
            continue
        break
    if len(arms) == 1:
        return arms[0], j
    return [{"k": "alt", "arms": arms}], j


def last_parse_error():
    """
    After ``compile_program`` / ``compile`` fail with a ``regex: ...`` parse error, returns
    ``(short_message, index_or_None)`` matching the arguments passed to the internal reporter
    (``index`` is ``None`` when the error is not tied to a pattern offset). Resets to ``None`` on
    successful ``compile_program``. Useful when the host cannot bind ``except ... as``.

    Note: in some hosts each cross-module call may reload library state; prefer
    ``diagnostic_compile_program`` when you need a reliable ``(error_tuple, program_or_none)``
    pair from tests.
    """
    return _RX_DIAG["last"]


def diagnostic_compile_program(pat: str):
    """
    Like ``compile_program``, but returns ``(None, program)`` on success or ``(last_parse_error(), None)``
    on parse failure, without re-raising—so callers (and tests) can read the tuple in the same
    interpreter instance that ran the parser.
    """
    _RX_DIAG["last"] = None
    try:
        p = compile_program(pat)
        return (None, p)
    except:
        return (last_parse_error(), None)


def compile_program(pat: str) -> list:
    """Parse ``pat`` into an opcode list. Raises ``regex: ...`` on syntax errors."""
    _RX_DIAG["last"] = None
    cap_counter = [0]
    nodes, i = _parse_alt(pat, 0, False, cap_counter, None)
    if i != len(pat):
        # See ``_rx_err`` docstring: defensive for current grammar; index is first unconsumed offset.
        _rx_err("trailing junk", i)
    _RX_DIAG["last"] = None
    return nodes


def _caps_clone(caps):
    if caps == None:
        return None
    return caps[:]


def _caps_restore(dst, src):
    if dst == None or src == None:
        return
    i = 0
    while i < len(src):
        dst[i] = src[i]
        i = i + 1


def _max_capture_id(nodes: list) -> int:
    m = 0
    i = 0
    while i < len(nodes):
        m = max(m, _max_capture_id_node(nodes[i]))
        i = i + 1
    return m


def _max_capture_id_node(node) -> int:
    k = node["k"]
    if k == "grp":
        inn = _max_capture_id(node["g"])
        cid = node.get("cap", None)
        if cid != None:
            return max(inn, cid)
        return inn
    if k == "alt":
        m = 0
        arms = node["arms"]
        ai = 0
        while ai < len(arms):
            m = max(m, _max_capture_id(arms[ai]))
            ai = ai + 1
        return m
    if k == "rep":
        return _max_capture_id_atom(node["a"])
    return 0


def _max_capture_id_atom(atom) -> int:
    if atom["k"] == "grp":
        inn = _max_capture_id(atom["g"])
        cid = atom.get("cap", None)
        if cid != None:
            return max(inn, cid)
        return inn
    return 0


def group_count(program: list) -> int:
    """Return the number of capturing ``(`` groups in ``program`` (highest 1-based index)."""
    return _max_capture_id(program)


def _match_node_plain(node, text: str, pos: int, lim: int):
    """Match one literal, dot, class escape (``\\d`` etc.), or ``[...]`` set token."""
    k = node["k"]
    if pos >= lim:
        return -1
    if k == "lit":
        if text[pos] == node["v"]:
            return pos + 1
        return -1
    if k == "dot":
        return pos + 1
    if k == "cls":
        if _cls_ok(text[pos], node["c"]):
            return pos + 1
        return -1
    if k == "set":
        ch = text[pos]
        set_map = node.get("m", None)
        if set_map == None:
            ok = _char_in_set(ch, node["s"])
        else:
            ok = set_map.get(ch, False)
        if node["n"]:
            ok = not ok
        if ok:
            return pos + 1
        return -1
    _rx_err("internal: expected plain atom")


def _match_one_unit(atom, text: str, pos: int, lim: int, caps):
    """One repetition step: a plain atom or a parenthesized sub-pattern."""
    if atom["k"] == "grp":
        r = _match_seq_bt(atom["g"], text, pos, lim, 0, caps)
        if r < 0:
            return -1
        gid = atom.get("cap", None)
        if caps != None and gid != None:
            caps[gid] = text[pos:r]
        return r
    return _match_node_plain(atom, text, pos, lim)


def _after_n_units(atom, text: str, pos: int, lim: int, n: int, caps):
    """Exclusive end after matching `atom` exactly `n` times in a row, or -1."""
    p = pos
    t = 0
    while t < n:
        nx = _match_one_unit(atom, text, p, lim, caps)
        if nx < 0:
            return -1
        p = nx
        t = t + 1
    return p


def _greedy_max_take(atom, text: str, pos: int, lim: int, hi):
    """
    Greedy repeat count for ``atom`` from ``pos`` (``hi`` ``None`` means unbounded).
    Probes with ``caps`` unset so measuring repeats does not write capture slots.
    """
    p = pos
    c = 0
    guard = 0
    max_guard = lim + lim + 128
    while guard < max_guard:
        guard = guard + 1
        if hi != None and c >= hi:
            break
        nx = _match_one_unit(atom, text, p, lim, None)
        if nx < 0:
            break
        if nx == p:
            c = c + 1
            p = nx
            break
        p = nx
        c = c + 1
    return c, p


def _match_seq_bt(nodes: list, text: str, pos: int, lim: int, idx: int, caps):
    """
    Match the remaining program from ``pos``; return exclusive end index or ``-1``.

    ``caps``: ``None`` skips capture writes; else a list of length ``group_count(program)+1``
    where indices ``1..`` hold capture substrings (or ``None``) when recording.
    """
    entry_snap = _caps_clone(caps)
    p = pos
    i = idx
    n_nodes = len(nodes)
    while i < n_nodes:
        node = nodes[i]
        node_k = node["k"]
        if node_k == "alt":
            arms = node["arms"]
            ai = 0
            matched = -1
            while ai < len(arms):
                snap_a = _caps_clone(caps)
                r = _match_seq_bt(arms[ai], text, p, lim, 0, caps)
                if r >= 0:
                    p = r
                    matched = 0
                    break
                if snap_a != None:
                    _caps_restore(caps, snap_a)
                ai = ai + 1
            if matched < 0:
                _caps_restore(caps, entry_snap)
                return -1
            i = i + 1
            continue
        if node_k == "rep":
            lo = node["lo"]
            hi = node["hi"]
            atom = node["a"]
            max_c, _p_g = _greedy_max_take(atom, text, p, lim, hi)
            if max_c < lo:
                _caps_restore(caps, entry_snap)
                return -1
            snap0 = _caps_clone(caps)
            k = max_c
            while k >= lo:
                if snap0 != None:
                    _caps_restore(caps, snap0)
                p2 = _after_n_units(atom, text, p, lim, k, caps)
                if p2 >= 0:
                    rest = _match_seq_bt(nodes, text, p2, lim, i + 1, caps)
                    if rest >= 0:
                        return rest
                k = k - 1
            _caps_restore(caps, entry_snap)
            return -1
        nx = _match_one_unit(node, text, p, lim, caps)
        if nx < 0:
            _caps_restore(caps, entry_snap)
            return -1
        p = nx
        i = i + 1
    return p


def _match_all(nodes: list, text: str, pos: int, lim: int, caps):
    return _match_seq_bt(nodes, text, pos, lim, 0, caps)


def _search_prefilter_node(program: list):
    """
    Return a plain atom node (lit/cls/set) that must match the first consumed character
    for any successful match attempt at a start index, else ``None``.
    """
    if len(program) == 0:
        return None
    node = program[0]
    k = node["k"]
    if k == "rep":
        if node["lo"] < 1:
            return None
        atom = node["a"]
        if atom["k"] == "lit" or atom["k"] == "cls" or atom["k"] == "set":
            return atom
        return None
    if k == "lit" or k == "cls" or k == "set":
        return node
    return None


def match_from(program: list, text: str, start: int = 0):
    """If ``program`` matches ``text`` from ``start``, return exclusive end index; else ``None``."""
    lim = len(text)
    end = _match_all(program, text, start, lim, None)
    if end < 0:
        return None
    return end


def match_from_captures(program: list, text: str, start: int = 0):
    """
    Like ``match_from``, but on success also fills capture strings.

    Returns ``None`` on failure. On success ``{"end": int, "groups": list}``: ``groups[0]``
    is ``text[start:end]``; ``groups[i]`` for ``i >= 1`` is capture ``i`` or ``None`` if that
    group did not participate (e.g. an unused optional branch).
    """
    ng = group_count(program)
    caps = [None] * (ng + 1)
    lim = len(text)
    end = _match_all(program, text, start, lim, caps)
    if end < 0:
        return None
    caps[0] = text[start:end]
    return {"end": end, "groups": caps}


def full_match(program: list, text: str, pos: int = 0) -> bool:
    """True iff ``text[pos:]`` is matched in full (match ends at ``len(text)``)."""
    e = match_from(program, text, pos)
    return e != None and e == len(text)


def search_from(program: list, text: str, pos: int = 0):
    """First match with ``start >= pos``: ``{"start", "end"}`` or ``None``."""
    lim = len(text)
    lead = _search_prefilter_node(program)
    s = pos
    if s < 0:
        s = 0
    while s <= lim:
        if lead != None:
            if s >= lim:
                return None
            if _match_node_plain(lead, text, s, lim) < 0:
                s = s + 1
                continue
        e = _match_all(program, text, s, lim, None)
        if e >= 0:
            return {"start": s, "end": e}
        s = s + 1
    return None


def search_from_captures(program: list, text: str, pos: int = 0):
    """Like ``search_from``, plus a ``groups`` list (same layout as ``match_from_captures``)."""
    ng = group_count(program)
    lim = len(text)
    lead = _search_prefilter_node(program)
    s = pos
    if s < 0:
        s = 0
    while s <= lim:
        if lead != None:
            if s >= lim:
                return None
            if _match_node_plain(lead, text, s, lim) < 0:
                s = s + 1
                continue
        caps = [None] * (ng + 1)
        end = _match_all(program, text, s, lim, caps)
        if end >= 0:
            caps[0] = text[s:end]
            return {"start": s, "end": end, "groups": caps}
        s = s + 1
    return None


def _normalize_pattern_string(pat: str) -> str:
    """Strip a leading ``re:`` prefix; if the string is ``/.../``, strip those delimiters (body only)."""
    if pat == None:
        _rx_err("pattern is None")
    pat = str(pat)
    if pat.startswith("re:"):
        pat = pat[3:]
    if len(pat) >= 2 and pat[0] == "/" and pat[-1] == "/":
        return pat[1:-1]
    return pat


def compile(pat: str):
    """
    Compile ``pat`` and return a dict for use from aliases: normalized ``pattern`` string,
    capture count ``groups``, callables ``fullmatch`` / ``full_match``, ``match``, ``search``,
    ``match_from``, ``match_from_captures``, ``search_captures``, and the opcode ``program``.

    Callables follow ``re.Pattern``-style names where possible; they return bool, span
    indices, or small dicts rather than CPython ``Match`` objects. Optional ``endpos``
    arguments are accepted for call-site similarity to ``re`` but are ignored (the engine
    always sees the full ``text``). Details: ``docs/gvars/regex.md``.
    """
    pat_norm = _normalize_pattern_string(pat)
    prog = compile_program(pat_norm)
    ng = group_count(prog)
    if ng == 0:
        def _mfc0(t, start = 0):
            end = match_from(prog, t, start)
            if end == None:
                return None
            return {"end": end, "groups": [t[start:end]]}

        def _sfc0(t, pos = 0, endpos = None):
            hit = search_from(prog, t, pos)
            if hit == None:
                return None
            s = hit["start"]
            e = hit["end"]
            return {"start": s, "end": e, "groups": [t[s:e]]}
    else:
        _mfc0 = lambda t, start = 0: match_from_captures(prog, t, start)
        _sfc0 = lambda t, pos = 0, endpos = None: search_from_captures(prog, t, pos)
    return {
        "pattern": pat_norm,
        "groups": ng,
        "fullmatch": lambda t, pos = 0, endpos = None: full_match(prog, t, pos),
        "full_match": lambda t, pos = 0, endpos = None: full_match(prog, t, pos),
        "match": lambda t, pos = 0, endpos = None: match_from(prog, t, pos),
        "search": lambda t, pos = 0, endpos = None: search_from(prog, t, pos),
        "match_from": lambda t, start = 0: match_from(prog, t, start),
        "match_from_captures": _mfc0,
        "search_captures": _sfc0,
        "program": prog,
    }


def diagnostic_compile(pat: str):
    """
    Like ``compile``, but returns ``(None, pattern_dict)`` on success or ``(last_parse_error(), None)``
    on failure (including ``_normalize_pattern_string`` failures), without re-raising.
    """
    _RX_DIAG["last"] = None
    try:
        return (None, compile(pat))
    except:
        return (last_parse_error(), None)
