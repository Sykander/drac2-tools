<drac2>
using(env="844087ed-cb06-4b66-9b36-b640519aa86f")
using(
    regex = env.gvars.regex,
    expect = env.gvars.expect,
)
expect = expect.expect

args = argparse(&ARGS&)
testcase = args.last("testcase", None)

if testcase == "regex gvar loads":
    p = regex.compile_program("a")

    expect(p).to.have.length(1)
elif testcase == "full_match should accept digit class":
    p = regex.compile_program("\\d")

    expect(regex.full_match(p, "7")).to.be(True)
    expect(regex.full_match(p, "x")).to.be(False)
elif testcase == "full_match should handle optional quantifier":
    p = regex.compile_program("a?")

    expect(regex.full_match(p, "")).to.be(True)
    expect(regex.full_match(p, "a")).to.be(True)
    expect(regex.full_match(p, "aa")).to.be(False)
elif testcase == "full_match should handle star quantifier":
    p = regex.compile_program("a*")

    expect(regex.full_match(p, "")).to.be(True)
    expect(regex.full_match(p, "aaa")).to.be(True)
elif testcase == "full_match should handle plus quantifier":
    p = regex.compile_program("a+")

    expect(regex.full_match(p, "a")).to.be(True)
    expect(regex.full_match(p, "aaa")).to.be(True)
    expect(regex.full_match(p, "")).to.be(False)
elif testcase == "full_match should handle exact brace count":
    p = regex.compile_program("a{2}")

    expect(regex.full_match(p, "aa")).to.be(True)
    expect(regex.full_match(p, "a")).to.be(False)
elif testcase == "full_match should handle brace min max":
    p = regex.compile_program("a{1,2}")

    expect(regex.full_match(p, "a")).to.be(True)
    expect(regex.full_match(p, "aa")).to.be(True)
    expect(regex.full_match(p, "aaa")).to.be(False)
elif testcase == "full_match should handle grouped repeat":
    p = regex.compile_program("(ab){2}")

    expect(regex.full_match(p, "abab")).to.be(True)
    expect(regex.full_match(p, "ab")).to.be(False)
elif testcase == "search_from should find substring":
    p = regex.compile_program("hello")
    hit = regex.search_from(p, "xhelloy")

    expect(hit).to.have.property("start", 1)
    expect(hit).to.have.property("end", 6)
elif testcase == "match_from should return end index":
    p = regex.compile_program("bc")
    end = regex.match_from(p, "abcd", 1)

    expect(end).to.be(3)
elif testcase == "full_match should accept positive character class":
    p = regex.compile_program("[abc]")

    expect(regex.full_match(p, "b")).to.be(True)
    expect(regex.full_match(p, "x")).to.be(False)
elif testcase == "full_match should accept negated character class":
    p = regex.compile_program("[^xyz]")

    expect(regex.full_match(p, "a")).to.be(True)
    expect(regex.full_match(p, "x")).to.be(False)
elif testcase == "full_match should accept range inside class":
    p = regex.compile_program("[a-c]")

    expect(regex.full_match(p, "b")).to.be(True)
    expect(regex.full_match(p, "d")).to.be(False)
elif testcase == "full_match should combine class escape and quantifier":
    p = regex.compile_program("[\\d]{2}")

    expect(regex.full_match(p, "37")).to.be(True)
    expect(regex.full_match(p, "3")).to.be(False)
elif testcase == "full_match should accept negated range":
    p = regex.compile_program("[^0-2]")

    expect(regex.full_match(p, "5")).to.be(True)
    expect(regex.full_match(p, "1")).to.be(False)
elif testcase == "full_match should accept mixed literals escapes and optional":
    p = regex.compile_program("Hello World!?\\d\\d\\s")

    expect(regex.full_match(p, "Hello World!37 ")).to.be(True)
    expect(regex.full_match(p, "Hello World08\t")).to.be(True)
    expect(regex.full_match(p, "Hello World!9 ")).to.be(False)
    expect(regex.full_match(p, "Hello World!37")).to.be(False)
elif testcase == "compile should expose full_match search exec and program":
    rx = regex.compile("ab+")

    expect(rx["full_match"]("abb")).to.be(True)
    expect(rx["test"]("a")).to.be(False)
    hit = rx["search"]("xxaby")
    expect(hit).to.have.property("start", 2)
    expect(hit).to.have.property("end", 4)
    expect(rx["exec"]("xxaby")).to.have.property("end", 4)
    expect(rx["match_from"]("zabc", 1)).to.be(3)
    expect(rx["program"]).to.have.length(2)
elif testcase == "pattern should behave like compile":
    a = regex.compile("x")
    b = regex.pattern("x")

    expect(a["full_match"]("x")).to.be(b["full_match"]("x"))
elif testcase == "compile should strip js style slash delimiters":
    rx = regex.compile("/\\d+/")

    expect(rx["full_match"]("404")).to.be(True)
    expect(rx["full_match"]("/404/")).to.be(False)
elif testcase == "compile should strip re colon prefix":
    rx = regex.compile("re:\\d+")

    expect(rx["full_match"]("9")).to.be(True)
elif testcase == "compile should not strip single leading slash":
    rx = regex.compile("/abc")

    expect(rx["full_match"]("/abc")).to.be(True)
elif testcase == "compile should match long haystack with search":
    pad = "x" * 250
    hay = pad + "needle" + pad
    rx = regex.compile("needle")

    hit = rx["search"](hay)
    expect(hit["start"]).to.be(250)
    expect(hit["end"]).to.be(256)
elif testcase == "compile should full_match long fixed pattern":
    body = "abcdefghij"
    rx = regex.compile(body)

    expect(rx["full_match"](body)).to.be(True)
elif testcase == "full_match should accept dot star across long string":
    rx = regex.compile_program(".*")

    s = "a" * 120 + "!" * 60
    expect(regex.full_match(rx, s)).to.be(True)
elif testcase == "full_match should accept negated empty class any char":
    rx = regex.compile_program("[^]")

    expect(regex.full_match(rx, "Z")).to.be(True)
    expect(regex.full_match(rx, "\n")).to.be(True)
elif testcase == "full_match should handle zero lower bound brace":
    rx = regex.compile_program("a{0}b")

    expect(regex.full_match(rx, "b")).to.be(True)
    expect(regex.full_match(rx, "ab")).to.be(False)
elif testcase == "full_match should handle brace unbounded max":
    rx = regex.compile_program("a{2,}b")

    expect(regex.full_match(rx, "aab")).to.be(True)
    expect(regex.full_match(rx, "aaaaab")).to.be(True)
    expect(regex.full_match(rx, "ab")).to.be(False)
elif testcase == "full_match should handle nested quantified group":
    rx = regex.compile_program("(a{1,2}){2}")

    expect(regex.full_match(rx, "aaaa")).to.be(True)
    expect(regex.full_match(rx, "aaa")).to.be(True)
    expect(regex.full_match(rx, "aa")).to.be(False)
elif testcase == "full_match should handle class with literal dot":
    rx = regex.compile_program("[.a]")

    expect(regex.full_match(rx, ".")).to.be(True)
    expect(regex.full_match(rx, "a")).to.be(True)
elif testcase == "full_match should handle escaped metachar as literal":
    rx = regex.compile_program("\\$\\d+")

    expect(regex.full_match(rx, "$12")).to.be(True)
    expect(regex.full_match(rx, "12")).to.be(False)
elif testcase == "search_from should return none when no match":
    rx = regex.compile_program("zzz")

    expect(regex.search_from(rx, "abcdef")).to.be(None)
elif testcase == "match_from should return none on failure":
    rx = regex.compile_program("abc")

    expect(regex.match_from(rx, "abx", 0)).to.be(None)
elif testcase == "compile_program should err on unclosed group":
    expect(lambda: regex.compile_program("(a")).to.raise_exception()
elif testcase == "compile_program should err on leading quantifier":
    expect(lambda: regex.compile_program("*a")).to.raise_exception()
elif testcase == "compile_program should err on empty positive class":
    expect(lambda: regex.compile_program("[]")).to.raise_exception()
elif testcase == "full_match should handle word class run":
    rx = regex.compile_program("\\w\\w\\w")

    expect(regex.full_match(rx, "Ab_")).to.be(True)
    expect(regex.full_match(rx, "A-9")).to.be(False)
elif testcase == "full_match should handle non digit class":
    rx = regex.compile_program("\\D+")

    expect(regex.full_match(rx, "abc-")).to.be(True)
    expect(regex.full_match(rx, "a1")).to.be(False)
elif testcase == "full_match should handle non space class":
    rx = regex.compile_program("\\S{3}")

    expect(regex.full_match(rx, "aB!")).to.be(True)
    expect(regex.full_match(rx, "a B")).to.be(False)
elif testcase == "full_match should handle non word class":
    rx = regex.compile_program("\\W+")

    expect(regex.full_match(rx, "?! ")).to.be(True)
    expect(regex.full_match(rx, "a")).to.be(False)
elif testcase == "full_match should combine multiple groups and literals":
    rx = regex.compile_program("(ID)-(\\d{4})")

    expect(regex.full_match(rx, "ID-0007")).to.be(True)
    expect(regex.full_match(rx, "ID-7")).to.be(False)
elif testcase == "search_from should find earliest double a":
    prog = regex.compile_program("aa")
    hit = regex.search_from(prog, "baaac")

    expect(hit["start"]).to.be(1)
    expect(hit["end"]).to.be(3)
elif testcase == "match_from should respect start offset at end":
    rx = regex.compile_program("c")

    expect(regex.match_from(rx, "abc", 2)).to.be(3)
    expect(regex.match_from(rx, "abc", 3)).to.be(None)
elif testcase == "full_match should handle digit range in class":
    rx = regex.compile_program("[3-6]")

    expect(regex.full_match(rx, "5")).to.be(True)
    expect(regex.full_match(rx, "2")).to.be(False)
elif testcase == "full_match should handle uppercase range in class":
    rx = regex.compile_program("[M-O]")

    expect(regex.full_match(rx, "N")).to.be(True)
    expect(regex.full_match(rx, "P")).to.be(False)
elif testcase == "full_match should handle optional group":
    rx = regex.compile_program("x(abc)?y")

    expect(regex.full_match(rx, "xy")).to.be(True)
    expect(regex.full_match(rx, "xabcy")).to.be(True)
    expect(regex.full_match(rx, "xab")).to.be(False)
elif testcase == "full_match should backtrack optional prefix for whole match":
    rx = regex.compile_program("(ha)?ha")

    expect(regex.full_match(rx, "haha")).to.be(True)
    expect(regex.full_match(rx, "ha")).to.be(True)
elif testcase == "full_match should backtrack star to satisfy suffix":
    rx = regex.compile_program("a*b")

    expect(regex.full_match(rx, "aaab")).to.be(True)
    expect(regex.full_match(rx, "b")).to.be(True)
elif testcase == "full_match should treat pipe as literal not alternation":
    rx = regex.compile_program("a|b")

    expect(regex.full_match(rx, "a|b")).to.be(True)
    expect(regex.full_match(rx, "a")).to.be(False)
elif testcase == "compile wrapper should reuse program for repeated checks":
    rx = regex.compile("a")

    expect(rx["full_match"]("a")).to.be(True)
    expect(rx["full_match"]("a")).to.be(True)
    expect(rx["full_match"]("b")).to.be(False)
elif testcase == "full_match should handle complex email like token":
    rx = regex.compile_program("[\\w.]+@[\\w]+")

    expect(regex.full_match(rx, "a.b@c")).to.be(True)
    expect(regex.full_match(rx, "@nope")).to.be(False)
elif testcase == "search should scan empty string for empty pattern":
    prog = regex.compile_program("")
    hit = regex.search_from(prog, "")

    expect(hit["start"]).to.be(0)
    expect(hit["end"]).to.be(0)
</drac2>
