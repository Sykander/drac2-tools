<drac2>
using(env="844087ed-cb06-4b66-9b36-b640519aa86f")
using(
    regex = env.gvars.regex,
    expect = env.gvars.expect,
)
expect = expect.expect

args = argparse(&ARGS&)
testcase = args.last("testcase", None)

if testcase == "regex gvar loads":
    rx = regex.compile("a")

    expect(rx.pattern).to.be("a")
    expect(rx.groups).to.be(0)
    expect(rx.full_match("a")).to.be(True)
elif testcase == "full_match should accept digit class":
    rx = regex.compile("\\d")

    expect(rx.full_match("7")).to.be(True)
    expect(rx.full_match("x")).to.be(False)
elif testcase == "full_match should handle optional quantifier":
    rx = regex.compile("a?")

    expect(rx.full_match("")).to.be(True)
    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("aa")).to.be(False)
elif testcase == "full_match should handle star quantifier":
    rx = regex.compile("a*")

    expect(rx.full_match("")).to.be(True)
    expect(rx.full_match("aaa")).to.be(True)
elif testcase == "full_match should handle plus quantifier":
    rx = regex.compile("a+")

    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("aaa")).to.be(True)
    expect(rx.full_match("")).to.be(False)
elif testcase == "full_match should handle exact brace count":
    rx = regex.compile("a{2}")

    expect(rx.full_match("aa")).to.be(True)
    expect(rx.full_match("a")).to.be(False)
elif testcase == "full_match should handle brace min max":
    rx = regex.compile("a{1,2}")

    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("aa")).to.be(True)
    expect(rx.full_match("aaa")).to.be(False)
elif testcase == "full_match should handle grouped repeat":
    rx = regex.compile("(ab){2}")

    expect(rx.full_match("abab")).to.be(True)
    expect(rx.full_match("ab")).to.be(False)
elif testcase == "search_from should find substring":
    rx = regex.compile("hello")
    hit = rx.search("xhelloy")

    expect(hit).to.have.property("start", 1)
    expect(hit).to.have.property("end", 6)
elif testcase == "match_from should return end index":
    rx = regex.compile("bc")
    end = rx.match_from("abcd", 1)

    expect(end).to.be(3)
elif testcase == "full_match should accept positive character class":
    rx = regex.compile("[abc]")

    expect(rx.full_match("b")).to.be(True)
    expect(rx.full_match("x")).to.be(False)
elif testcase == "full_match should accept negated character class":
    rx = regex.compile("[^xyz]")

    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("x")).to.be(False)
elif testcase == "full_match should accept range inside class":
    rx = regex.compile("[a-c]")

    expect(rx.full_match("b")).to.be(True)
    expect(rx.full_match("d")).to.be(False)
elif testcase == "full_match should combine class escape and quantifier":
    rx = regex.compile("[\\d]{2}")

    expect(rx.full_match("37")).to.be(True)
    expect(rx.full_match("3")).to.be(False)
elif testcase == "full_match should accept negated range":
    rx = regex.compile("[^0-2]")

    expect(rx.full_match("5")).to.be(True)
    expect(rx.full_match("1")).to.be(False)
elif testcase == "full_match should accept mixed literals escapes and optional":
    rx = regex.compile("Hello World!?\\d\\d\\s")

    expect(rx.full_match("Hello World!37 ")).to.be(True)
    expect(rx.full_match("Hello World08\t")).to.be(True)
    expect(rx.full_match("Hello World!9 ")).to.be(False)
    expect(rx.full_match("Hello World!37")).to.be(False)
elif testcase == "compile wrapper should expose python style pattern api":
    rx = regex.compile("ab+")

    expect(rx.pattern).to.be("ab+")
    expect(rx.groups).to.be(0)
    expect(rx.fullmatch("abb")).to.be(True)
    expect(rx.fullmatch("a")).to.be(False)
    expect(rx.full_match("abb")).to.be(True)
    expect(rx.match("abb")).to.be(3)
    expect(rx.match("zabb")).to.be(None)
    hit = rx.search("xxaby")
    expect(hit.start).to.be(2)
    expect(hit.end).to.be(4)
    hit_pos = rx.search("xab", 1)
    expect(hit_pos.start).to.be(1)
    expect(hit_pos.end).to.be(3)
    expect(rx.match_from("zabc", 1)).to.be(3)
    expect(rx).to.have.property("match_from_captures")
    expect(rx).to.have.property("search_captures")
elif testcase == "compile should be deterministic for same pattern string":
    a = regex.compile("x")
    b = regex.compile("x")

    expect(a.pattern).to.be(b.pattern)
    expect(a.fullmatch("x")).to.be(b.fullmatch("x"))
elif testcase == "compile should strip js style slash delimiters":
    rx = regex.compile("/\\d+/")

    expect(rx.full_match("404")).to.be(True)
    expect(rx.full_match("/404/")).to.be(False)
elif testcase == "compile should strip re colon prefix":
    rx = regex.compile("re:\\d+")

    expect(rx.full_match("9")).to.be(True)
elif testcase == "compile should not strip single leading slash":
    rx = regex.compile("/abc")

    expect(rx.full_match("/abc")).to.be(True)
elif testcase == "compile should match long haystack with search":
    pad = "x" * 250
    hay = pad + "needle" + pad
    rx = regex.compile("needle")

    hit = rx.search(hay)
    expect(hit.start).to.be(250)
    expect(hit.end).to.be(256)
elif testcase == "compile should full_match long fixed pattern":
    body = "abcdefghij"
    rx = regex.compile(body)

    expect(rx.full_match(body)).to.be(True)
elif testcase == "full_match should accept dot star across long string":
    rx = regex.compile(".*")

    s = "a" * 120 + "!" * 60
    expect(rx.full_match(s)).to.be(True)
elif testcase == "full_match should accept negated empty class any char":
    rx = regex.compile("[^]")

    expect(rx.full_match("Z")).to.be(True)
    expect(rx.full_match("\n")).to.be(True)
elif testcase == "full_match should handle zero lower bound brace":
    rx = regex.compile("a{0}b")

    expect(rx.full_match("b")).to.be(True)
    expect(rx.full_match("ab")).to.be(False)
elif testcase == "full_match should handle brace unbounded max":
    rx = regex.compile("a{2,}b")

    expect(rx.full_match("aab")).to.be(True)
    expect(rx.full_match("aaaaab")).to.be(True)
    expect(rx.full_match("ab")).to.be(False)
elif testcase == "full_match should handle nested quantified group":
    rx = regex.compile("(a{1,2}){2}")

    expect(rx.full_match("aaaa")).to.be(True)
    expect(rx.full_match("aaa")).to.be(True)
    expect(rx.full_match("aa")).to.be(False)
elif testcase == "full_match should handle class with literal dot":
    rx = regex.compile("[.a]")

    expect(rx.full_match(".")).to.be(True)
    expect(rx.full_match("a")).to.be(True)
elif testcase == "full_match should handle escaped metachar as literal":
    rx = regex.compile("\\$\\d+")

    expect(rx.full_match("$12")).to.be(True)
    expect(rx.full_match("12")).to.be(False)
elif testcase == "search_from should return none when no match":
    rx = regex.compile("zzz")

    expect(rx.search("abcdef")).to.be(None)
elif testcase == "match_from should return none on failure":
    rx = regex.compile("abc")

    expect(rx.match_from("abx", 0)).to.be(None)
elif testcase == "compile_program should err on unclosed group":
    expect(lambda: regex.compile("(a")).to.raise_exception()
elif testcase == "compile_program should err on leading quantifier":
    expect(lambda: regex.compile("*a")).to.raise_exception()
elif testcase == "compile_program should err on empty positive class":
    expect(lambda: regex.compile("[]")).to.raise_exception()
elif testcase == "compile should err on invalid patterns like compile_program":
    expect(lambda: regex.compile("(a")).to.raise_exception()
    expect(lambda: regex.compile("[]")).to.raise_exception()
    expect(lambda: regex.compile("/[]/")).to.raise_exception()
elif testcase == "compile_program parse errors report correct pattern indices":
    def expect_idx(pat, want_idx):
        errt, res = regex.diagnostic_compile(pat)
        expect(res == None).to.be(True)
        expect(errt != None).to.be(True)
        expect(errt[1]).to.be(want_idx)

    expect_idx("a{", 1)
    expect_idx("a{,", 2)
    expect_idx("a{1x", 3)
    expect_idx("a{1,a", 4)
    expect_idx("a{1,2", 1)
    expect_idx("\\", 0)
    expect_idx("[\\D]", 1)
    expect_idx("[z-a]", 2)
    expect_idx("[a-9]", 2)
    expect_idx("[", 0)
    expect_idx("[a-\\]", 3)
    expect_idx("[ab", 0)
    expect_idx("[]", 1)
    expect_idx(")", 0)
    expect_idx("(ab", 0)
    expect_idx("(?P<x>)", 0)
    expect_idx("(?:ab", 0)
    expect_idx("*", 0)
    expect_idx("(", 0)

    en, pc = regex.diagnostic_compile("/[]/")
    expect(pc == None).to.be(True)
    expect(en[1]).to.be(1)

    ok_t, ok_rx = regex.diagnostic_compile("a")
    expect(ok_t == None).to.be(True)
    expect(ok_rx != None).to.be(True)
    expect(ok_rx.pattern).to.be("a")

    none_err, none_prog = regex.diagnostic_compile(None)
    expect(none_prog == None).to.be(True)
    expect(none_err[0]).to.be("pattern is None")
    expect(none_err[1] == None).to.be(True)
elif testcase == "full_match should handle word class run":
    rx = regex.compile("\\w\\w\\w")

    expect(rx.full_match("Ab_")).to.be(True)
    expect(rx.full_match("A-9")).to.be(False)
elif testcase == "full_match should handle non digit class":
    rx = regex.compile("\\D+")

    expect(rx.full_match("abc-")).to.be(True)
    expect(rx.full_match("a1")).to.be(False)
elif testcase == "full_match should handle non space class":
    rx = regex.compile("\\S{3}")

    expect(rx.full_match("aB!")).to.be(True)
    expect(rx.full_match("a B")).to.be(False)
elif testcase == "full_match should handle non word class":
    rx = regex.compile("\\W+")

    expect(rx.full_match("?! ")).to.be(True)
    expect(rx.full_match("a")).to.be(False)
elif testcase == "full_match should combine multiple groups and literals":
    rx = regex.compile("(ID)-(\\d{4})")

    expect(rx.full_match("ID-0007")).to.be(True)
    expect(rx.full_match("ID-7")).to.be(False)
elif testcase == "search_from should find earliest double a":
    rx = regex.compile("aa")
    hit = rx.search("baaac")

    expect(hit.start).to.be(1)
    expect(hit.end).to.be(3)
elif testcase == "match_from should respect start offset at end":
    rx = regex.compile("c")

    expect(rx.match_from("abc", 2)).to.be(3)
    expect(rx.match_from("abc", 3)).to.be(None)
elif testcase == "full_match should handle digit range in class":
    rx = regex.compile("[3-6]")

    expect(rx.full_match("5")).to.be(True)
    expect(rx.full_match("2")).to.be(False)
elif testcase == "full_match should handle uppercase range in class":
    rx = regex.compile("[M-O]")

    expect(rx.full_match("N")).to.be(True)
    expect(rx.full_match("P")).to.be(False)
elif testcase == "full_match should handle optional group":
    rx = regex.compile("x(abc)?y")

    expect(rx.full_match("xy")).to.be(True)
    expect(rx.full_match("xabcy")).to.be(True)
    expect(rx.full_match("xab")).to.be(False)
elif testcase == "full_match should backtrack optional prefix for whole match":
    rx = regex.compile("(ha)?ha")

    expect(rx.full_match("haha")).to.be(True)
    expect(rx.full_match("ha")).to.be(True)
elif testcase == "full_match should backtrack star to satisfy suffix":
    rx = regex.compile("a*b")

    expect(rx.full_match("aaab")).to.be(True)
    expect(rx.full_match("b")).to.be(True)
elif testcase == "full_match should treat pipe as alternation":
    rx = regex.compile("a|b")

    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("b")).to.be(True)
    expect(rx.full_match("c")).to.be(False)
elif testcase == "full_match should treat escaped pipe as literal":
    rx = regex.compile("a\\|b")

    expect(rx.full_match("a|b")).to.be(True)
    expect(rx.full_match("a")).to.be(False)
elif testcase == "full_match should alternate grouped branches":
    rx = regex.compile("(cat|dog)")

    expect(rx.full_match("cat")).to.be(True)
    expect(rx.full_match("dog")).to.be(True)
    expect(rx.full_match("cow")).to.be(False)
elif testcase == "search_from should find first alternation branch":
    rx = regex.compile("foo|bar")
    hit = rx.search("xbarz")

    expect(hit.start).to.be(1)
    expect(hit.end).to.be(4)
elif testcase == "full_match should alternate three arms":
    rx = regex.compile("1|22|333")

    expect(rx.full_match("1")).to.be(True)
    expect(rx.full_match("22")).to.be(True)
    expect(rx.full_match("333")).to.be(True)
    expect(rx.full_match("2")).to.be(False)
elif testcase == "full_match should use first matching alternation arm":
    rx = regex.compile("aa|a")

    expect(rx.full_match("aa")).to.be(True)
    expect(rx.full_match("a")).to.be(True)
elif testcase == "full_match should combine alternation with suffix":
    rx = regex.compile("(red|blue)fish")

    expect(rx.full_match("redfish")).to.be(True)
    expect(rx.full_match("bluefish")).to.be(True)
    expect(rx.full_match("greenfish")).to.be(False)
elif testcase == "compile wrapper should reuse program for repeated checks":
    rx = regex.compile("a")

    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("b")).to.be(False)
elif testcase == "compile wrapper captures helpers should work with zero groups":
    rx = regex.compile("abc")

    expect(rx.groups).to.be(0)
    m = rx.match_from_captures("xabc", 1)
    expect(m != None).to.be(True)
    expect(m.end).to.be(4)
    expect(m.groups).to.have.length(1)
    expect(m.groups[0]).to.be("abc")
    expect(rx.match_from_captures("xab", 1)).to.be(None)

    hit = rx.search_captures("zzabcqq")
    expect(hit != None).to.be(True)
    expect(hit.start).to.be(2)
    expect(hit.end).to.be(5)
    expect(hit.groups).to.have.length(1)
    expect(hit.groups[0]).to.be("abc")
    expect(rx.search_captures("zzz")).to.be(None)
elif testcase == "full_match should handle complex email like token":
    rx = regex.compile("[\\w.]+@[\\w]+")

    expect(rx.full_match("a.b@c")).to.be(True)
    expect(rx.full_match("@nope")).to.be(False)
elif testcase == "search should scan empty string for empty pattern":
    rx = regex.compile("")
    hit = rx.search("")

    expect(hit.start).to.be(0)
    expect(hit.end).to.be(0)
elif testcase == "stress search needle after four hundred char pad":
    pad = "x" * 400
    hay = pad + "needle" + pad
    rx = regex.compile("needle")
    hit = rx.search(hay)

    expect(hit.start).to.be(400)
    expect(hit.end).to.be(406)
elif testcase == "stress full_match digit brace two hundred":
    text = "7" * 200
    rx = regex.compile("\\d{200}")

    expect(rx.full_match(text)).to.be(True)
    expect(rx.full_match(text + "7")).to.be(False)
elif testcase == "stress nested groups depth twelve":
    d = 12
    pat = "(" * d + "@" + ")" * d
    rx = regex.compile(pat)

    expect(rx.full_match("@")).to.be(True)
elif testcase == "stress quantified pair eighty repeats":
    rx = regex.compile("(ab){80}")
    body = "ab" * 80

    expect(rx.full_match(body)).to.be(True)
elif testcase == "stress dot star five hundred char string":
    rx = regex.compile(".*")
    s = "m" * 300 + "n" * 200

    expect(rx.full_match(s)).to.be(True)
elif testcase == "stress alternation forty eight fixed width arms":
    parts = []
    for i in range(48):
        si = str(i)
        if len(si) == 1:
            si = "0" + si
        parts.append("a" + si)
    pat = "|".join(parts)
    rx = regex.compile(pat)

    expect(rx.full_match("a47")).to.be(True)
    expect(rx.full_match("a00")).to.be(True)
    expect(rx.full_match("a48")).to.be(False)
elif testcase == "stress word class brace two fifty":
    rx = regex.compile("\\w{250}")
    text = "a" * 250

    expect(rx.full_match(text)).to.be(True)
elif testcase == "stress mixed alts quantifiers and classes":
    rx = regex.compile("([01]{2}|aa){50}(z|ww)")
    body = "01" * 50 + "ww"

    expect(rx.full_match(body)).to.be(True)
elif testcase == "match_from_captures should return two groups":
    rx = regex.compile("(ID)-(\\d{4})")
    m = rx.match_from_captures("ID-0007", 0)

    expect(m != None).to.be(True)
    expect(m.end).to.be(7)
    expect(m.groups[0]).to.be("ID-0007")
    expect(m.groups[1]).to.be("ID")
    expect(m.groups[2]).to.be("0007")
elif testcase == "match_from_captures should leave optional group none":
    rx = regex.compile("x(a)?y")
    m = rx.match_from_captures("xy", 0)

    expect(m != None).to.be(True)
    expect(m.groups[1]).to.be(None)
elif testcase == "search_captures should include groups in hit":
    rx = regex.compile("f(o+)(bar)")
    hit = rx.search_captures("xxfoooobary")

    expect(hit.start).to.be(2)
    expect(hit.end).to.be(10)
    expect(hit.groups[0]).to.be("foooobar")
    expect(hit.groups[1]).to.be("oooo")
    expect(hit.groups[2]).to.be("bar")
elif testcase == "compiled dict groups key should skip noncapturing group":
    rx = regex.compile("a(?:no)b(c)")

    expect(rx.groups).to.be(1)
    m = rx.match_from_captures("abnoc", 0)

    expect(m).to.be(None)
    m2 = rx.match_from_captures("anobc", 0)

    expect(m2 != None).to.be(True)
    expect(m2.groups[1]).to.be("c")
elif testcase == "full_match with leading empty alternation arm should not try later arm":
    rx = regex.compile("|ab")

    expect(rx.full_match("")).to.be(True)
    expect(rx.full_match("ab")).to.be(False)
elif testcase == "compile_program should err on unsupported question paren":
    expect(lambda: regex.compile("(?P<x>a)")).to.raise_exception()
elif testcase == "full_match should treat brace min equal max as exact count":
    rx = regex.compile("a{1,1}")

    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("")).to.be(False)
    rx2 = regex.compile("a{3,3}")

    expect(rx2.full_match("aaa")).to.be(True)
    expect(rx2.full_match("aa")).to.be(False)
elif testcase == "full_match should accept hyphen only class":
    rx = regex.compile("[-]")

    expect(rx.full_match("-")).to.be(True)
    expect(rx.full_match("a")).to.be(False)
elif testcase == "full_match should accept hyphen at class edge":
    rx = regex.compile("[-a]")

    expect(rx.full_match("-")).to.be(True)
    expect(rx.full_match("a")).to.be(True)
    rx2 = regex.compile("[a-]")

    expect(rx2.full_match("-")).to.be(True)
    expect(rx2.full_match("b")).to.be(False)
elif testcase == "full_match should accept negated hyphen class":
    rx = regex.compile("[^-]")

    expect(rx.full_match("z")).to.be(True)
    expect(rx.full_match("-")).to.be(False)
elif testcase == "full_match should let dot match newline":
    rx = regex.compile(".")

    expect(rx.full_match("\n")).to.be(True)
elif testcase == "full_match should repeat noncapturing group":
    rx = regex.compile("(?:ab){2}")

    expect(rx.full_match("abab")).to.be(True)
    expect(rx.full_match("ab")).to.be(False)
elif testcase == "full_match should accept trailing empty alternation arm":
    rx = regex.compile("a|")

    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("")).to.be(True)
    expect(rx.full_match("b")).to.be(False)
elif testcase == "full_match should accept escaped rbracket inside class":
    rx = regex.compile("[\\]]")

    expect(rx.full_match("]")).to.be(True)
    expect(rx.full_match("a")).to.be(False)
elif testcase == "full_match should accept negated class excluding rbracket":
    rx = regex.compile("[^\\]]")

    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("]")).to.be(False)
elif testcase == "full_match should accept negated caret literal in class":
    rx = regex.compile("[^^]")

    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("^")).to.be(False)
elif testcase == "search_from should backtrack dot star for suffix":
    rx = regex.compile(".*c")
    hit = rx.search("xxxc")

    expect(hit.start).to.be(0)
    expect(hit.end).to.be(4)
elif testcase == "full_match should handle nested alternation with suffix":
    rx = regex.compile("((a|b)c|d)e")

    expect(rx.full_match("ace")).to.be(True)
    expect(rx.full_match("bce")).to.be(True)
    expect(rx.full_match("de")).to.be(True)
    expect(rx.full_match("ae")).to.be(False)
elif testcase == "match_from_captures should split greedy plus groups":
    rx = regex.compile("(a+)(b+)")
    m = rx.match_from_captures("aabbb", 0)

    expect(m != None).to.be(True)
    expect(m.groups[0]).to.be("aabbb")
    expect(m.groups[1]).to.be("aa")
    expect(m.groups[2]).to.be("bbb")
elif testcase == "search_from_captures should find nested alt capture":
    rx = regex.compile("(x|(yz))")
    hit = rx.search_captures("qqyzz", 0)

    expect(hit != None).to.be(True)
    expect(hit.groups[0]).to.be("yz")
    expect(hit.groups[1]).to.be("yz")
    expect(hit.groups[2]).to.be("yz")
elif testcase == "full_match should accept string anchors ^ and $":
    rx = regex.compile("^a$")

    expect(rx.full_match("a")).to.be(True)
    expect(rx.full_match("ab")).to.be(False)
    expect(rx.full_match("ba")).to.be(False)
elif testcase == "search_from should respect ^ only at string index zero":
    rx = regex.compile("^foo")
    hit = rx.search("foo", 0)

    expect(hit != None).to.be(True)
    expect(hit.start).to.be(0)
    expect(hit.end).to.be(3)
    expect(rx.search("xfoo", 0)).to.be(None)
elif testcase == "search_from should return None for leading ^ when pos gt zero":
    rx = regex.compile("^foo")

    expect(rx.search("foo", 1)).to.be(None)
elif testcase == "search_from should find arm without ^ across offsets":
    rx = regex.compile("^a|b")
    hit = rx.search("xb", 0)

    expect(hit != None).to.be(True)
    expect(hit.start).to.be(1)
    expect(hit.end).to.be(2)
elif testcase == "full_match should accept escaped caret as literal":
    rx = regex.compile("\\^x")

    expect(rx.full_match("^x")).to.be(True)
    expect(rx.full_match("x")).to.be(False)
elif testcase == "full_match should accept empty string for ^$":
    rx = regex.compile("^$")

    expect(rx.full_match("")).to.be(True)
    expect(rx.full_match("x")).to.be(False)
elif testcase == "compile_program should err on quantified ^":
    errt, res = regex.diagnostic_compile("^?")

    expect(res).to.be(None)
    expect(errt != None).to.be(True)
elif testcase == "match_from_captures should work with leading ^ and captures":
    rx = regex.compile("^(a)$")
    m = rx.match_from_captures("a", 0)

    expect(m != None).to.be(True)
    expect(m.groups[0]).to.be("a")
    expect(m.groups[1]).to.be("a")
elif testcase == "match_from should fail ^ when start not at string zero even if suffix matches":
    rx = regex.compile("^a")

    expect(rx.match_from("aa", 1)).to.be(None)
elif testcase == "search_from_captures should honor all arms leading ^":
    rx = regex.compile("^a|^bc")
    hit = rx.search_captures("bc", 0)

    expect(hit != None).to.be(True)
    expect(hit.start).to.be(0)
    expect(hit.groups[0]).to.be("bc")
elif testcase == "match_from should return None when start past end":
    rx = regex.compile("a")

    expect(rx.match_from("x", 2)).to.be(None)
elif testcase == "full_match should be false when pos past end":
    rx = regex.compile("a")

    expect(rx.full_match("x", 2)).to.be(False)
elif testcase == "search_from should return None when pos past haystack end":
    rx = regex.compile("a")

    expect(rx.search("x", 2)).to.be(None)
