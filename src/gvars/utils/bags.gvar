# Bags
# A reusable library for interacting with bags
# https://avrae.io/dashboard/workshop/6296b723c964982e890e5315

bags_code = "bags"

try:
    default_char = character()
except:
    default_char = None

# So that we can do multiple updates on the bags
bags_cache = {}
def get_bags(char = None):
    char = char if char != None else default_char

    if not bags_cache.get(char.name, False):
        bags_cache[char.name] = load_json(char.get_cvar(bags_code)) if char.get_cvar(bags_code) else []

    return bags_cache[char.name]

def set_bags(bags: list[Tuple[str, dict]], char = None):
    char = char if char != None else default_char
    bags_cache[char.name] = bags
    char.set_cvar(bags_code, dump_json(bags))

def get_bag(bag_name: str, char = None) -> dict:
    bags = get_bags(char)
    matches = [bag for bag in bags if bag[0] == bag_name]
    if len(matches) == 0:
        return {}
    else:
        return matches[0][1]

def set_bag(bag_name: str, bag_contents: dict, char = None):
    bags = get_bags(char)
    bag_index = None
    for index, bag in enumerate(bags):
        if bag[0] == bag_name:
            bag_index = index
            break

    if bag_index == None:
        bags.append([bag_name, bag_contents])
    else:
        bags[bag_index] = [bag_name, bag_contents]

    set_bags(bags, char)

# modify_bag
# modifies the characters bag
#
# item - the name of the item
# count - OPTIONAL 1 - the amount to add or remove
# bag - OPTIONAL Equipment - the bag to modify
# char - OPTIONAL the active character - the character to modify bags for
#
# returns a Tuple [did_update, update_message]
def modify_bag(
    item: str,
    count: int | None = None,
    bag: str | None = None,
    char = None,
) -> Tuple[bool, str]:
    count = count if count != None else 1
    bag = bag if bag != None else "Equipment"
    char = char if char != None else default_char

    bag_contents = get_bag(bag, char)
    current_count = bag_contents.get(item, 0)
    new_count = current_count + count

    if new_count < 0:
        return False, f"Couldn't update {char.name}'s bag {bag} with {count}x {item} because the new count would be {new_count}."

    bag_contents[item] = new_count
    set_bag(bag, bag_contents, char)

    return True, f"""{f"{abs(count)}x " if abs(count) != 1 else ""}{item} {"added to" if count > 0 else "removed from"} {char.name}'s bag {bag}."""
