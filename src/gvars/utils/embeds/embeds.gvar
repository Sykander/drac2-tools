using(env="844087ed-cb06-4b66-9b36-b640519aa86f")
using(
    commands = env.gvars.commands,
)

# Embed
# A general purpose embed handler for creating embeds
#
# For a one off embed use `get_embed` but if you have multiple embed exit points use `configure_get_embed` instead


def format_to_length(content: str, length: int) -> str:
    if len(content) < length:
        return content

    return f'{content[0:length - 3]}...'


def get_field(title, text = "", inline = False):
    return f"{title}|{text}{'|inline' if inline else ''}"


# get_embed
# check `!help embed -here`
def get_embed(
    desc: str | None = None,
    title: str | None = None,
    fields: list[str] | None = None,
    footer: str | None = None,
    image: str | None = None,
    thumb: str | None = None,
    color: str | None = None,
    timeout: int | None = None
) -> str:
    if fields == None:
        fields = []

    actions = ["embed"]
    args = [
        ["-title", title],
        ["-desc", format_to_length(desc, 4020) if desc != None else desc],
    ] + [["-f", format_to_length(field, 1020)] for field in fields]

    if footer != None:
        args.append(["-footer", footer])

    if image != None:
        args.append(["-image", image])

    if thumb != None:
        args.append(["-thumb", thumb])

    if color != None:
        args.append(["-color", color])

    if timeout != None:
        args.append(["-t", str(timeout)])

    return commands.get_command(actions, args)


def configure_get_embed(
    desc: str | None = None,
    title: str | None = None,
    fields: list[str] | None = None,
    footer: str | None = None,
    image: str | None = None,
    thumb: str | None = None,
    color: str | None = None,
    timeout: int | None = None
):
    if fields == None:
        fields = []

    return lambda desc = desc, title = title, fields = fields, footer = footer, image = image, thumb = thumb, color = color, timeout = timeout: get_embed(
        desc = desc,
        fields = fields,
        title = title,
        footer = footer,
        image = image,
        thumb = thumb,
        color = color,
        timeout = timeout
    )