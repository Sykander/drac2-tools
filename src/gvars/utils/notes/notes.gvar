# notes
# Reuseable functions for the notes alias
# https://avrae.io/dashboard/workshop/6342ac449fb55be1a501367c
#
# If you just want to add a note use the `push` function

cname = "notes"


def _active_character():
    try:
        return character()
    except:
        return None


def _resolve_optional_character(char = None):
    return char if char != None else _active_character()


def _require_character(char = None, context: str = "this operation"):
    c = _resolve_optional_character(char)
    if c == None:
        err(f"No character available for {context}.")
    return c


def get_notebooks_dict(char = None):
    char = _require_character(char, "notes")

    return load_json(char.get_cvar(cname, "{}"))


def set_notebooks_dict(contents, char = None):
    char = _require_character(char, "notes")

    char.set_cvar(cname, dump_json(contents))


def get_notebook_id(notebook, char = None):
    char = _require_character(char, "notes")

    notebooks = get_notebooks_dict(char)
    return notebooks.get(notebook, "note_" + notebook)


def set_notebook_id(notebook, notebook_id, char = None):
    char = _require_character(char, "notes")

    notebooks = get_notebooks_dict(char)
    notebooks[notebook] = notebook_id
    set_notebooks_dict(notebooks, char)


def get_notebook(notebook, char = None):
    char = _require_character(char, "notes")

    notebook_id = get_notebook_id(notebook, char)
    return load_json(char.get_cvar(notebook_id, "[]"))


def set_notebook(notebook, contents, char = None):
    char = _require_character(char, "notes")

    notebook_id = get_notebook_id(notebook, char)
    char.set_cvar(notebook_id, dump_json(contents))


def create_notebook(notebook, contents = [], char = None):
    char = _require_character(char, "notes")

    set_notebook_id(notebook, get_notebook_id(notebook, char), char)
    set_notebook(notebook, contents, char)


# Push
#
# notebook - the name of the notebook
# note - the note to push
# char - OPTIONAL explicit character; defaults to active character()
#
# returns the updated notebook
def push(notebook: str, note: str, char = None) -> list[str]:
    char = _require_character(char, "notes")

    contents = get_notebook(notebook, char)
    contents.append(note)
    create_notebook(notebook, contents, char)
    return get_notebook(notebook, char)
