# Rolls
# A Resuseable library for saves, checks, attacks and regular rolls
# Use get_roll as the main entry point

skills_abilities = {
    "strength": "strength",
    "athletics": "strength",
    "dexterity": "dexterity",
    "initiative": "dexterity",
    "acrobatics": "dexterity",
    "sleightOfHand": "dexterity",
    "stealth": "dexterity",
    "constitution": "constitution",
    "intelligence": "intelligence",
    "arcana": "intelligence",
    "history": "intelligence",
    "investigation": "intelligence",
    "nature": "intelligence",
    "religion": "intelligence",
    "wisdom": "wisdom",
    "animalHandling": "wisdom",
    "insight": "wisdom",
    "medicine": "wisdom",
    "perception": "wisdom",
    "survival": "wisdom",
    "charisma": "charisma",
    "deception": "charisma",
    "intimidation": "charisma",
    "performance": "charisma",
    "persuasion": "charisma"
}

save_abilities = {
    "strength": "strength",
    "dexterity": "dexterity",
    "constitution": "constitution",
    "intelligence": "intelligence",
    "wisdom": "wisdom",
    "charisma": "charisma",
    "death": None,
    "honor": None,
    "sanity": None
}

attack_type_abilities = {
    "melee": "strength",
    "ranged": "dexterity"
}

def get_readable_name_for_skill(skill_name, ability_name = None, is_passive = False):
    if skill_name.lower().startswith("sleight"):
        readable_skill_name = "Sleight of Hand"
    elif skill_name.lower().startswith("animal"):
        readable_skill_name = "Animal Handling"
    else:
        readable_skill_name = skill_name.capitalize()

    using_default_ability = ability_name == None or get_default_ability_for_skill(skill_name) == ability_name
    type_of_check = "Passive Check" if is_passive else "Check"

    if using_default_ability:
        return f'{readable_skill_name} {type_of_check}'
    else:
        return f'{ability_name.capitalize()} ({readable_skill_name}) {type_of_check}'

def get_readable_name_for_save(save_name, ability_name = None):
    readable_save_name = save_name.capitalize()

    using_default_ability = ability_name == None or get_default_ability_for_save(save_name) == ability_name

    if using_default_ability:
        return f'{readable_save_name} Saving Throw'
    else:
        return f'{ability_name.capitalize()} ({readable_save_name}) Saving Throw'

def get_readable_name_for_attack(attack_type, ability_name):
    readable_attack_type = attack_type.capitalize()

    using_default_ability = ability_name == None or get_default_ability_for_attack_type(attack_type) == ability_name

    if using_default_ability:
        return f'{readable_attack_type} Attack'
    else:
        return f'{readable_attack_type} Attack ({ability_name})'

def get_default_ability_for_skill(skill_name: string):
    if skill_name in skills_abilities:
        return skills_abilities[skill_name]

    return None

def get_default_ability_for_save(save_name: string):
    if save_name in save_abilities:
        return save_abilities[save_name]

    return None

def get_default_ability_for_attack_type(attack_type: string):
    if attack_type in attack_type_abilities:
        return attack_type_abilities[attack_type]

    return None

def join_advantage(advantage_a, advantage_b):
    if advantage_a == None and advantage_b == None:
        return None
    elif advantage_a == None:
        return advantage_b
    elif advantage_b == None:
        return advantage_a
    elif advantage_a != advantage_b:
        return None
    else:
        return advantage_a

def get_d20(adv: bool | None = None, eadv: bool = False):
    if adv == None:
        return "1d20"

    if adv == True and eadv == True:
        return "3d20kh1"

    if adv == True:
        return "2d20kh1"

    if adv == False:
        return "2d20kl1"

# Joins a list of roll strings together
# roll_strings - the list of rolls to join
# returns a single roll string
def join_roll_strings(roll_strings: list[str]):
    if len(roll_strings) == 0:
        return ""

    result_str = ""
    for roll_str in roll_strings:
        if roll_str in [None, ""]:
            continue

        if result_str != "" and roll_str[0] not in ["+", "-"]:
            result_str += "+"

        result_str += roll_str

    return result_str

# Get a roll string for a character using a specific skill
# character
# skill_name - the skill to roll for
# ability_name - the ability to use for the skill roll or None for default
# bonus - any bonuses to add to the roll
# adv - true for advantage, false for disadvantage, none for flat
# returns a single roll string
def get_skill_check(
    character,
    skill_name: str,
    ability_name: str | None = None,
    bonuses: list[str] | None = None,
    adv: bool | None = None
):
    if bonuses == None:
        bonuses = []

    if (character == None):
        based20 = get_d20(adv)
        return join_roll_strings([based20] + bonuses)

    skill = None
    for (b_name, b_skill) in character.skills:
        if skill_name == b_name:
            skill = b_skill

    if (skill == None):
        err(f"Didn't find skill for {skill_name}!")

    has_reliable_talent = character_has_reliable_talent(character)
    has_halfling_luck = character_has_halfing_luck(character)
    has_indomitable_might = character_has_indomitable_might(character)
    using_strength = ability_name == "strength" or ability_name == None and get_default_ability_for_skill(skill_name) == "strength"

    mod_override = None
    if ability_name != None:
        ability_mod = character.stats.get_mod(ability_name)
        if (ability_mod == None):
            err(f"Didn't find ability mod for {ability_name}!")

        ability_to_replace = get_default_ability_for_skill(skill_name)
        if ability_to_replace == None:
            ability_to_replace_mod = 0
        else:
            ability_to_replace_mod = character.stats.get_mod(ability_to_replace)

        mod_override = skill.value + ability_mod - ability_to_replace_mod

    base_adv = join_advantage(adv, skill.adv)

    based20 = skill.d20(
        base_adv = base_adv,
        reroll = 1 if has_halfling_luck else None,
        min_val = 10 if has_reliable_talent else None,
        mod_override = mod_override
    )
    
    base_roll = join_roll_strings([based20] + bonuses)
    if using_strength and has_indomitable_might:
        return f'({base_roll}, {character.stats.get_mod("strength")})kh1'
    return base_roll

# Get a roll string for a character using a specific save
# character
# save_name - the save to roll for
# ability_name - the ability to use for the save roll or None for default
# bonus - any bonuses to add to the roll
# adv - true for advantage, false for disadvantage, none for flat
# returns a single roll string
def get_saving_throw(
    character,
    save_name: str,
    ability_name: str | None = None,
    bonuses: list[str] | None = None,
    adv: bool | None = None
):
    if bonuses == None:
        bonuses = []

    if (character == None):
        based20 = get_d20(adv)
        return join_roll_strings([based20] + bonuses)

    if (save_name not in save_abilities.keys()):
        err(f"Didn't find save for {save_name}!")

    save = character.saves.get(save_name)

    has_halfling_luck = character_has_halfing_luck(character)

    mod_override = None
    if ability_name != None:
        ability_mod = character.stats.get_mod(ability_name)
        if (ability_mod == None):
            err(f"Didn't find ability mod for {ability_name}!")

        ability_to_replace = get_default_ability_for_save(skill_name)

        if ability_to_replace == None:
            ability_to_replace_mod = 0
        else:
            ability_to_replace_mod = character.stats.get_mod(ability_to_replace)

        mod_override = save.value + ability_mod - ability_to_replace_mod

    base_adv = join_advantage(adv, save.adv)

    based20 = save.d20(
        base_adv = base_adv,
        reroll = 1 if has_halfling_luck else None,
        min_val = None,
        mod_override = mod_override
    )
    return join_roll_strings([based20] + bonuses)

def get_attack_roll(
    character,
    attack_type: str,
    ability_name: str | None = None,
    bonuses: list[str] | None = None,
    adv: bool | None = None,
    eadv: bool = False
):
    if character == None:
        based20 = get_d20(adv = adv, eadv = eadv)
        return join_roll_strings([based20] + bonuses)

    ability_name = ability_name if ability_name != None else get_default_ability_for_attack_type(attack_type)

    if ability_name == None:
        err(f'Unrecognised attack type {attack_type}')

    ability_mod = character.stats.get_mod(ability_name)
    prof_mod = character.stats.prof_bonus

    if bonuses == None:
        bonuses = []

    based20 = get_d20(
        adv = adv,
        eadv = eadv
    )
    return join_roll_strings([based20] + [str(ability_mod + prof_mod)] + bonuses)

def get_passive_roll(
    character,
    skill_name,
    ability_name: str | None = None,
    bonuses: list[str] | None = None,
    adv: bool | None = None,
):
    if bonuses == None:
        bonuses = []

    if (character == None):
        if adv == True:
            bonuses.append("+5[advantage]")
        elif adv == False:
            bonuses.append("-5[disadvantage]")
        return join_roll_strings(["10"] + bonuses)

    skill = None
    for (b_name, b_skill) in character.skills:
        if skill_name == b_name:
            skill = b_skill

    if (skill == None):
        err(f"Didn't find skill for {skill_name}!")

    has_indomitable_might = character_has_indomitable_might(character)
    using_strength = ability_name == "strength" or ability_name == None and get_default_ability_for_skill(skill_name) == "strength"

    mod_override = 0
    if ability_name != None:
        ability_mod = character.stats.get_mod(ability_name)
        if (ability_mod == None):
            err(f"Didn't find ability mod for {ability_name}!")

        ability_to_replace = get_default_ability_for_skill(skill_name)
        if ability_to_replace == None:
            ability_to_replace_mod = 0
        else:
            ability_to_replace_mod = character.stats.get_mod(ability_to_replace)

        mod_override = skill.value + ability_mod - ability_to_replace_mod

    base_adv = join_advantage(adv, skill.adv)

    if base_adv == True:
        bonuses.append("+5[advantage]")
    elif base_adv == False:
        bonuses.append("-5[disadvantage]")

    has_observant = character_has_observant(character)
    observant_perception_check = ability_name in [None, "wisdom"] and skill_name == "perception"
    observant_investigation_check = ability_name in [None, "intelligence"] and skill_name == "investigation"
    if has_observant and (observant_investigation_check or observant_perception_check):
        bonuses.append("+5[Observant]")

    based20 = f"10+{skill.value + mod_override}"
    base_roll = join_roll_strings([based20] + bonuses)
    if using_strength and has_indomitable_might:
        return f'({base_roll}, {character.stats.get_mod("strength")})kh1'
    return base_roll


def get_damage_roll(
    damage_dice: str,
    bonuses: list[str] | None = None
):
    if bonuses == None:
        bonuses = []

    return join_roll_strings([damage_dice] + bonuses)

def character_has_halfing_luck(character):
    if character == None:
        return False

    return "halfling" in character.race.lower() 

def character_has_reliable_talent(character):
    if character == None:
        return False

    return character.levels.get("Rogue") >= 11

def character_has_observant(character):
    if character == None:
        return False

    return "observant" in character.get_cvar("feats", "").lower()

def character_has_indomitable_might(character):
    if character == None:
        return False

    return character.levels.get("Barbarian") >= 18

def get_ability_to_use_from_args(args):
    if args.last("str"):
        return "strength"

    if args.last("dex"):
        return "dexterity"

    if args.last("con"):
        return "constitution"

    if args.last("wis"):
        return "wisdom"

    if args.last("int"):
        return "intelligence"

    if args.last("cha"):
        return "charisma"

    return None

# get_roll
# Processes a roll
#
# character - the character to use
# roll_name - the name of the check or save, or the type of the attack, or if just a flat roll then the roll string itself
# args - the ParsedArguments to use for the roll
# roll_type - either 'check' for Skill Checks and Ability Checks; 'save' for Saving Throws; 'attack' for attack rolls;  or 'roll' for rolls
# ability_name - OPTIONAL None - string for the ability to use if overriding
# dc - OPTIONAL None - the dc for the check or the ac if its an attack
# adv - OPTIONAL None - advantage on the roll
# bonuses - OPTIONAL [] - any bonuses to add to the roll
#
# returns a dict of the roll results
def get_roll(
    character,
    roll_name: str,
    args: ParsedArguments,
    roll_type: str, # check, save, attack, roll
    ability_name: str | None = None, # Ability to use for roll
    dc: int | None = None, # also ac for attack rolls,
    adv: bool | None = None,
    bonuses: list[str] = []
) -> dict:
    bonuses += args.get("b")
    adv = join_advantage(adv, args.adv(boolwise = True))
    eadv = args.adv(eadv = True) == 2 # returns 2 for elven accuracy

    if args.last("guidance") and roll_type in ["check", "passive"]:
        bonuses.append("1d4[Guidance]")

    if args.last("resistance") and roll_type == "save":
        bonuses.append("1d4[Resistance]")

    if args.last("bless") and roll_type in ["attack", "save"]:
        bonuses.append("1d4[Bless]")

    ability_name = ability_name if ability_name != None else get_ability_to_use_from_args(args)

    if roll_type == "check":
        roll_str = get_skill_check(
            character = character,
            skill_name = roll_name,
            ability_name = ability_name,
            bonuses = bonuses,
            adv = adv
        )
        readable_roll_name = get_readable_name_for_skill(roll_name, ability_name)
    elif roll_type == "passive":
        roll_str = get_passive_roll(
            character = character,
            skill_name = roll_name,
            ability_name = ability_name,
            bonuses = bonuses,
            adv = adv
        )
        readable_roll_name = get_readable_name_for_skill(roll_name, ability_name, is_passive = True)
    elif roll_type == "save":
        roll_str = get_saving_throw(
            character = character,
            save_name = roll_name,
            ability_name = ability_name,
            bonuses = bonuses,
            adv = adv
        )
        readable_roll_name = get_readable_name_for_save(roll_name, ability_name)
    elif roll_type == "attack":
        roll_str = get_attack_roll(
            character = character,
            attack_type = roll_name,
            ability_name = ability_name,
            bonuses = bonuses,
            adv = adv,
            eadv = eadv
        )
        readable_roll_name = get_readable_name_for_attack(roll_name, ability_name)
    elif roll_type == "roll":
        roll_str = roll_name
        readable_roll_name = 'Roll'
    else:
        err(f'Unknown roll roll_type {roll_type}')

    roll_result = vroll(roll_str)

    if dc == None and roll_type == "save" and roll_name == "death":
        dc = 10

    passed = None
    if dc != None:
        passed = roll_result.total >= dc

    crit = False
    crit_fail = False
    if roll_type in ["attack", "save", "check"] or (roll_type == "roll" and  "d20" in roll_name):
        dice_elements = roll_result.dice.split(" ")
        first_roll = dice_elements[0]
        first_result = dice_elements[1]
        if "d20" in first_roll:
            items_to_check = [first_result]
            if "(" in first_result and ")" not in first_result:
                for dice in dice_elements[2:]:
                    items_to_check.append(dice)
                    if ")" in dice:
                        break
            for item in items_to_check:
                if item in ["(**1**,","**1**,", "(**1**)", "**1**)"]:
                    crit_fail = True
                    break
                elif item in ["(**20**,", "**20**,", "(**20**)", "**20**)"]:
                    crit = True
                    break
    
    if roll_type == "attack" or (roll_type == "save" and roll_name == "death"):
        if crit:
            passed = True
        elif crit_fail:
            passed = False

    return {
        "roll": roll_result,
        "total": roll_result.total,
        "full": roll_result.full,
        "name": readable_roll_name,
        "roll_string": roll_str,
        "dc": dc,
        "passed": passed,
        "crit": crit,
        "crit_fail": crit_fail
    }
