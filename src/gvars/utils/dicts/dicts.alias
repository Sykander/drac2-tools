<drac2>
using(env="844087ed-cb06-4b66-9b36-b640519aa86f")
using(
    dicts = env.gvars.dicts,
    expect = env.gvars.expect,
)
expect = expect.expect
args = argparse(&ARGS&)
testcase = args.last("testcase", None)

if testcase == "is_dict should give a bool whether the item is a dict or not":
    item_a = None
    item_b = []
    item_c = 1
    item_d = "hello world"
    item_e = {}
    expected_a = False
    expected_b = False
    expected_c = False
    expected_d = False
    expected_e = True

    result_a = dicts.is_dict(item_a)
    result_b = dicts.is_dict(item_b)
    result_c = dicts.is_dict(item_c)
    result_d = dicts.is_dict(item_d)
    result_e = dicts.is_dict(item_e)

    expect(result_a).to.be(expected_a)
    expect(result_b).to.be(expected_b)
    expect(result_c).to.be(expected_c)
    expect(result_d).to.be(expected_d)
    expect(result_e).to.be(expected_e)
</drac2>
