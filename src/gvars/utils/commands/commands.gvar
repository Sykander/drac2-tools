# commands
# a reuseable command string library
# avoids adding the ctx.prefix except on multilines, you're expected to add this yourself if necessary (normally isn't necessary)

MULTILINE_BASE = "multiline "


# get_multiline
#
# commands - a list of commands for the multiline
#
# returns a multiline command string
def get_multiline(commands: list[str]) -> str:
    return MULTILINE_BASE + ctx.prefix + ("\n" + ctx.prefix).join(commands)


# get_quotes
# encodes a given value with quotes for commands
#
# value - the value to wrap in quotes
#
# returns the value wrapped in quotes
def get_quotes(value: str) -> str:
    problem_chars = [" ", "'", '"', "\t", "\n"]
    problems = [char for char in problem_chars if char in value]
    if len(problems) == 0:
        return value

    if '"' not in value:
        return f'"{value}"'

    if "'" not in value:
        return f"'{value}'"

    return f"《{value}》"


# get_command
#
# actions - list of actions for the command eg. ["init", "attack", "longsword"]
# args - OPTIONAL a dict of the args on the command eg. { "-t": "GO1" }
#
# returns the command string
def get_command(actions: list[str], args: list[Tuple[str, str]] | None = None) -> str:
    command = " ".join([get_quotes(action) for action in actions])

    if args != None:
        command += " " + " ".join([f"{arg[0]} {get_quotes(arg[1])}" for arg in args])

    return command