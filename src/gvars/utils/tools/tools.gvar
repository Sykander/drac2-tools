char = character()

def search_for_tool(toolname):
    return lists.search_list(tools_list, toolname)

# Returns true if the character has expertise or proficiency in the given tool
def get_has_proficiency(
    toolname: str,
    char = char
) -> bool:
    if toolname not in tools_list:
        return False

    tool_prof = ch.get_cvar(bags.tool_prof_code, "")
    tool_exp = ch.get_cvar(bags.tool_exp_code, "")

    return toolname in tool_prof or toolname in tool_exp

def get_has_expertise(
    toolname: str,
    char = char
) -> bool:
    if toolname not in tools_list:
        return False

    tool_exp = ch.get_cvar(bags.tool_exp_code, "")

    return toolname in tool_exp