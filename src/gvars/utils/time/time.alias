<drac2>
using(env="844087ed-cb06-4b66-9b36-b640519aa86f")
using(
    timelib = env.gvars.time,
    expect = env.gvars.expect,
)
expect = expect.expect

args = argparse(&ARGS&)
testcase = args.last("testcase", None)

if testcase == "time gvar loads":
    expected_seconds_per_minute = 60

    seconds = timelib.MINUTE // timelib.SECOND

    expect(seconds).to.be(expected_seconds_per_minute)
elif testcase == "get_time should break down a timestamp into components":
    ts = 3661

    t = timelib.get_time(ts)

    expect(t).to.have.property("days", 0)
    expect(t).to.have.property("hours", 1)
    expect(t).to.have.property("minutes", 1)
    expect(t).to.have.property("seconds", 1)
</drac2>
