# Embed
# A general purpose embed handler for creating embeds
# 
# For a one off embed use `get_embed` but if you have multiple embed exit points use `configure_get_embed` instead

# Use these special quote marks to wrap the final content - so that " and ' don't break strings
EMBED_LEFT_QUOTE="《"
EMBED_RIGHT_QUOTE="》"

EMBED_BASE = 'embed '

def format_to_length(content: str, length: int) -> str:
    if len(content) < length:
        return content

    return f'{content[0:length - 3]}...'

def get_field(title, text = "", inline = False):
    return f"{title}|{text}{'|inline' if inline else ''}"

# get_embed
# check `!help embed -here`
#
# desc - OPTIONAL "" - the desc
# title - OPTIONAL "" - the title
# fields - OPTIONAL [] - list of fields
# footer 
def get_embed(
    desc: str | None = None,
    title: str | None = None,
    fields: list[str] = [],
    footer: str | None = None,
    image: str | None = None,
    thumb: str | None = None,
    color: str | None = None,
    timeout: int | None = None
) -> str:
    embed = EMBED_BASE
    embed += f" -title {EMBED_LEFT_QUOTE}{title}{EMBED_RIGHT_QUOTE}"
    embed += f" -desc {EMBED_LEFT_QUOTE}{format_to_length(desc, 4020)}{EMBED_RIGHT_QUOTE}"

    fields_strings = " ".join([f'-f {EMBED_LEFT_QUOTE}{format_to_length(field, 1020)}{EMBED_RIGHT_QUOTE}' for field in fields])
    if fields_strings != "":
        embed += " " + fields_strings

    if footer != None:
        embed += f" -footer {EMBED_LEFT_QUOTE}{footer}{EMBED_RIGHT_QUOTE}"

    if image != None:
        embed += f" -image {image}"

    if thumb != None:
        embed += f" -thumb {thumb}"

    if color != None:
        embed += f" -color {color}"

    if timeout != None:
        embed += f" -t {timeout}"

    return embed

def configure_get_embed(
    desc: str | None = None,
    title: str | None = None,
    fields: list[str] = [],
    footer: str | None = None,
    image: str | None = None,
    thumb: str | None = None,
    color: str | None = None,
    timeout: int | None = None
):
    return lambda
        desc = desc 
        title = title 
        fields = fields 
        footer = footer 
        image = image 
        thumb = thumb 
        color = color 
        timeout = timeout
    : get_embed(
        desc = desc,
        fields = fields,
        title = title,
        footer = footer,
        image = image,
        thumb = thumb,
        color = color,
        timeout = timeout
    )