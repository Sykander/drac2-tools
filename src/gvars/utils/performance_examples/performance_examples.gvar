"""Micro-patterns for Drac2 statement-budget awareness.

These functions exist so **``performance_examples-perf``** (and manual probes) can
compare *equivalent-result* coding styles under Avrae's **per-invocation statement cap**.

**Raw probed maxima** (``probe_perf_boundaries.py``, **``-loops``** in **``performance_examples-perf.alias-test``** match these, cap **120000**, ``--max-binary 20``):
adv list **4313** vs if-chain **3420**; three-way list **4509** vs if **3968**;
``dict.get`` for present ``"a"`` **6612** vs ``in``+subscript **5834**; missing ``"key"`` default ``1`` **7085** vs ``a["key"] if "key" in a else 1`` **7084** (tie); tuple vs list ``in`` **4508** tie;
known-key **``d["k"]``** **7628** vs **``d.get("k",0)``** **6610**; one-arg present **``a.get("key")``** **7627** vs **``a["key"]``** **8262**; counter **``i=i+1``** vs **``i+=1``** both **10000** at **``reps``** 1 (``max_loops`` plateau); with **``-reps``** inner increments **``i+=1``** allows more outer **``loops``** than assign (probe each counter testcase with the same **``-reps``**; see **``.cursor/scripts/probe_perf_boundaries.py``** ``--help`` epilog); string **``s=s+"x"``** **9013** vs **``s+="x"``** **9914**.
Re-validate with ``python3 .cursor/scripts/probe_perf_boundaries.py --preset performance_examples --max-binary 20`` (see **``.cursor/README.md``**; preset baselines track this file’s **``-loops``**).

Compared variants keep the same return value for the same ``loops`` so checksum assertions stay strict.
"""

# Pair 1 — four-way d20 shape (list index vs if/elif). List index allows more loop iterations here.


def bench_adv_dice_list_index(loops):
    """``adv`` fixed to ``2`` → always ``'3d20kh1'``; sum string lengths."""
    s = 0
    i = 0
    while i < loops:
        adv_int = 2
        dice = ["1d20", "2d20kh1", "3d20kh1", "2d20kl1"][adv_int]
        s = s + len(dice)
        i = i + 1
    return s


def bench_adv_dice_if_chain(loops):
    """Same observable result as ``bench_adv_dice_list_index`` for ``adv_int == 2``."""
    s = 0
    i = 0
    while i < loops:
        adv_int = 2
        if adv_int == 0:
            dice = "1d20"
        elif adv_int == 1:
            dice = "2d20kh1"
        elif adv_int == 2:
            dice = "3d20kh1"
        else:
            dice = "2d20kl1"
        s = s + len(dice)
        i = i + 1
    return s


# Pair 2 — three-way string pick (index 1).


def bench_three_way_list_index(loops):
    """Pick middle token ``'bb'`` via list index."""
    s = 0
    i = 0
    while i < loops:
        pick = 1
        tok = ["aa", "bb", "cc"][pick]
        s = s + len(tok)
        i = i + 1
    return s


def bench_three_way_if_chain(loops):
    """Same as list index for ``pick == 1``."""
    s = 0
    i = 0
    while i < loops:
        pick = 1
        if pick == 0:
            tok = "aa"
        elif pick == 1:
            tok = "bb"
        else:
            tok = "cc"
        s = s + len(tok)
        i = i + 1
    return s


# Pair 3 — read stable int from small mapping: ``dict.get`` vs ``in`` + subscript.


def bench_dict_get_repeated(loops):
    """``m.get('a', 0)`` each iteration."""
    m = {"a": 7, "b": 3}
    s = 0
    i = 0
    while i < loops:
        s = s + m.get("a", 0)
        i = i + 1
    return s


def bench_dict_in_and_subscript(loops):
    """``m['a']`` guarded by ``'a' in m`` each iteration."""
    m = {"a": 7, "b": 3}
    s = 0
    i = 0
    while i < loops:
        if "a" in m:
            s = s + m["a"]
        else:
            s = s + 0
        i = i + 1
    return s


# Pair 3b — **missing** key, numeric default ``1``: ``a.get("key", 1)`` vs ``a["key"] if "key" in a else 1``.


def bench_dict_get_missing_key_default_one(loops):
    """``key`` absent each time; ``.get`` returns ``1``."""
    a = {"other": 0}
    s = 0
    i = 0
    while i < loops:
        s = s + a.get("key", 1)
        i += 1
    return s


def bench_dict_in_else_subscript_missing_key_default_one(loops):
    """Same checksum as ``bench_dict_get_missing_key_default_one`` (ternary avoids subscript when absent)."""
    a = {"other": 0}
    s = 0
    i = 0
    while i < loops:
        s = s + (a["key"] if "key" in a else 1)
        i += 1
    return s


# Pair 4 — fixed small membership: tuple vs list literal.


def bench_membership_tuple_literal(loops):
    """``needle in (1, 2, 3, 4, 5)`` — true each time."""
    s = 0
    i = 0
    while i < loops:
        needle = 3
        if needle in (1, 2, 3, 4, 5):
            s = s + 1
        i = i + 1
    return s


def bench_membership_list_literal(loops):
    """Same truth value as tuple variant."""
    s = 0
    i = 0
    while i < loops:
        needle = 3
        if needle in [1, 2, 3, 4, 5]:
            s = s + 1
        i = i + 1
    return s


# Pair 5 — known key every time: ``d["k"]`` vs ``d.get("k", default)`` (regex uses both styles).


def bench_dict_bracket_known_key(loops):
    """Subscript when the key is always present (common after a shape tag check)."""
    d = {"k": 42}
    s = 0
    i = 0
    while i < loops:
        s = s + d["k"]
        i = i + 1
    return s


def bench_dict_get_known_key_with_default(loops):
    """Same numeric result as bracket form; ``get`` carries a default branch in CPython—compare in Drac2."""
    d = {"k": 42}
    s = 0
    i = 0
    while i < loops:
        s = s + d.get("k", 0)
        i = i + 1
    return s


# Pair 5b — key always present: one-arg ``a.get("key")`` (implicit ``None`` default unused) vs ``a["key"]``.


def bench_dict_get_bare_present_key(loops):
    """``a.get("key")`` with ``key`` always present (same int as subscript)."""
    a = {"key": 99, "other": 0}
    s = 0
    i = 0
    while i < loops:
        s = s + a.get("key")
        i += 1
    return s


def bench_dict_bracket_present_same_key(loops):
    """``a["key"]`` when ``key`` is always present."""
    a = {"key": 99, "other": 0}
    s = 0
    i = 0
    while i < loops:
        s = s + a["key"]
        i += 1
    return s


# Pair 6 — loop counter update (``regex.gvar`` uses ``i = i + 1`` throughout).
# With ``reps_per_iter > 1``, each outer step runs ``reps_per_iter`` increments inside an inner
# ``while`` (more statements per outer trip than ``reps_per_iter == 1``). Use ``-reps`` on
# ``performance_examples-perf`` to stress ``+=`` vs assign beyond the default ``max_loops`` plateau.


def bench_counter_plus_assign(loops, reps_per_iter=1):
    """``i = i + 1``; ``reps_per_iter`` times per outer step when ``reps_per_iter > 1``."""
    if reps_per_iter == 1:
        i = 0
        while i < loops:
            i = i + 1
        return i
    i = 0
    n = 0
    while n < loops:
        r = 0
        while r < reps_per_iter:
            i = i + 1
            r = r + 1
        n = n + 1
    return i


def bench_counter_plus_eq(loops, reps_per_iter=1):
    """``i += 1`` when supported; same return shape as ``bench_counter_plus_assign``."""
    if reps_per_iter == 1:
        i = 0
        while i < loops:
            i += 1
        return i
    i = 0
    n = 0
    while n < loops:
        r = 0
        while r < reps_per_iter:
            i += 1
            r = r + 1
        n = n + 1
    return i


# Pair 7 — string accumulation (``regex.gvar`` uses ``out += pool[si]`` in one hot path).


def bench_string_concat_assign(loops):
    """``s = s + "x"`` — new string each step; length equals ``loops``."""
    s = ""
    i = 0
    while i < loops:
        s = s + "x"
        i = i + 1
    return len(s)


def bench_string_concat_plus_eq(loops):
    """``s += "x"`` if supported; same length as assign form."""
    s = ""
    i = 0
    while i < loops:
        s += "x"
        i = i + 1
    return len(s)


def expected_checksum_adv_dice(loops):
    """``len('3d20kh1') * loops`` == ``7 * loops``."""
    return 7 * loops


def expected_checksum_three_way(loops):
    return 2 * loops


def expected_checksum_dict(loops):
    return 7 * loops


def expected_checksum_membership(loops):
    return loops


def expected_checksum_dict_known_key(loops):
    return 42 * loops


def expected_checksum_counter(loops, reps_per_iter=1):
    return loops * reps_per_iter


def expected_checksum_string_len(loops):
    return loops


def expected_checksum_missing_key_default_one(loops):
    return loops


def expected_checksum_dict_bare_present(loops):
    return 99 * loops
