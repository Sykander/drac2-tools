<drac2>
using(env="844087ed-cb06-4b66-9b36-b640519aa86f")
using(
    performance_examples = env.gvars.performance_examples,
    expect = env.gvars.expect,
)
expect = expect.expect
pe = performance_examples

args = argparse(&ARGS&)
testcase = args.last("testcase", None)

if testcase == "benchmark adv dice list index loop should keep checksum":
    loops = int(args.last("loops", "1"))
    if loops < 1:
        loops = 1
    got = pe.bench_adv_dice_list_index(loops)
    expect(got).to.be(pe.expected_checksum_adv_dice(loops))
elif testcase == "benchmark adv dice if chain loop should keep checksum":
    loops = int(args.last("loops", "1"))
    if loops < 1:
        loops = 1
    got = pe.bench_adv_dice_if_chain(loops)
    expect(got).to.be(pe.expected_checksum_adv_dice(loops))
elif testcase == "benchmark three way list index loop should keep checksum":
    loops = int(args.last("loops", "1"))
    if loops < 1:
        loops = 1
    got = pe.bench_three_way_list_index(loops)
    expect(got).to.be(pe.expected_checksum_three_way(loops))
elif testcase == "benchmark three way if chain loop should keep checksum":
    loops = int(args.last("loops", "1"))
    if loops < 1:
        loops = 1
    got = pe.bench_three_way_if_chain(loops)
    expect(got).to.be(pe.expected_checksum_three_way(loops))
elif testcase == "benchmark dict get loop should keep checksum":
    loops = int(args.last("loops", "1"))
    if loops < 1:
