    got = pe.bench_dict_get_known_key_with_default(loops)
    expect(got).to.be(pe.expected_checksum_dict_known_key(loops))
elif testcase == "benchmark counter plus assign loop should keep checksum":
    loops = int(args.last("loops", "1"))
    if loops < 1:
        loops = 1
    got = pe.bench_counter_plus_assign(loops)
    expect(got).to.be(pe.expected_checksum_counter(loops))
